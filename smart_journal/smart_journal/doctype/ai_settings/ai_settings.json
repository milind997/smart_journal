  },
  {
   "fieldname": "company_defaults_section",
   "fieldtype": "Section Break",
   "label": "Company Default Accounts",
   "description": "Credit account (bank or inter-company), VAT account, and cost center per company. Used when creating Journal Entries from Purchase Requests."
  },
